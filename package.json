{
  "name": "compelem-ui",
  "version": "0.1.0",
  "description": "A UI component library built with compelem, myfx and uiik",
  "type": "module",
  "main": "compelem-ui.umd.js",
  "module": "compelem-ui.es.js",
  "types": "index.d.ts",
  "scripts": {
    "dev": "vite --port 5174 --host",
    "build:lib": "vite build --config vite.lib.config.ts",
    "build:debug": "vite build --config vite.lib.config.ts --minify false --sourcemap --outDir dist-debug",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "bootstrap-icons": "^1.13.1",
    "compelem": "^0.26.5",
    "myfx": "^1.15.10",
    "uiik": "^1.4.2"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^2.1.9",
    "@vitest/ui": "^2.1.9",
    "jsdom": "^25.0.1",
    "sass": "^1.102.0",
    "typescript": "^5.5.4",
    "vite": "^5.4.2",
    "vite-plugin-compelem-css": "0.1.0",
    "vite-plugin-compelem-strip-comments": "0.1.0",
    "vite-plugin-dts": "^4.2.1",
    "vitest": "^2.1.9"
  }
}