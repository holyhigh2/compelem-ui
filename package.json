{
  "name": "compelem-ui",
  "version": "0.2.3",
  "description": "A UI component library built with compelem, myfx and uiik",
  "keywords": [
    "web components",
    "custom elements",
    "ui",
    "components",
    "compelem"
  ],
  "homepage": "https://github.com/holyhigh2/compelem-ui#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/holyhigh2/compelem-ui.git"
  },
  "bugs": {
    "url": "https://github.com/holyhigh2/compelem-ui/issues"
  },
  "license": "MIT",
  "type": "module",
  "main": "./dist/compelem-ui.es.js",
  "module": "./dist/compelem-ui.es.js",
  "types": "./dist/index.d.ts",
  "browserslist": [
    "chrome >= 99",
    "edge >= 99",
    "firefox >= 101",
    "safari >= 16.4"
  ],
  "sideEffects": [
    "**/*.css",
    "./dist/compelem-ui.es.js",
    "./dist/register.es.js",
    "./dist/ce-*.es.js",
    "./dist/icons/full.es.js"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/compelem-ui.es.js"
    },
    "./index.css": "./dist/index.css",
    "./package.json": "./package.json",
    "./dist/*": "./dist/*",
    "./icons": {
      "types": "./dist/icons/icons.d.ts",
      "import": "./dist/icons.es.js"
    },
    "./icons/full": {
      "types": "./dist/icons/full.d.ts",
      "import": "./dist/icons/full.es.js"
    },
    "./locale": {
      "types": "./dist/locale/index.d.ts",
      "import": "./dist/locale.es.js"
    },
    "./register": {
      "types": "./dist/register.d.ts",
      "import": "./dist/register.es.js"
    },
    "./icons/icons": {
      "types": "./dist/icons/icons.d.ts",
      "import": "./dist/icons.es.js"
    },
    "./ce-*": {
      "types": "./dist/entries/ce-*.d.ts",
      "import": "./dist/ce-*.es.js"
    }
  },
  "scripts": {
    "build:lib": "node scripts/gen.mjs entries && vite build --config vite.lib.config.ts",
    "build:debug": "vite build --config vite.lib.config.ts --minify false --sourcemap --outDir dist-debug",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/gen.mjs entries && vitest run",
    "test:coverage": "node scripts/gen.mjs entries && vitest run --coverage",
    "prepublishOnly": "npm run typecheck && npm run check && npm run test:coverage && npm run build:lib && npm run verify:pkg",
    "gen": "node scripts/gen.mjs types",
    "check": "node scripts/gen.mjs types --check && node scripts/check.mjs all --strict",
    "verify:pkg": "node scripts/verify-package.mjs"
  },
  "peerDependencies": {
    "compelem": ">=0.30.0-beta.13 <0.31.0",
    "myfx": ">=2.0.0",
    "uiik": "^1.5.0"
  },
  "devDependencies": {
    "compelem": "^0.30.0-beta.13",
    "@compelem/compiler": "^0.30.0-beta.13",
    "@vitest/coverage-v8": "^2.1.9",
    "exceljs": "^4.4.0",
    "jsdom": "^30.1.3",
    "myfx": "2.0.0",
    "sass": "^1.106.1",
    "typescript": "^5.9.3",
    "uiik": "1.5.1",
    "vite": "^5.4.2",
    "vite-plugin-compelem-css": "^0.2.0",
    "vite-plugin-compelem-strip-comments": "^0.2.0",
    "vite-plugin-dts": "^4.2.1",
    "vitest": "^2.1.9"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ]
}